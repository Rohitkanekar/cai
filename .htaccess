# =========================================================
# CONCRETE ARTS INDIA - ROOT .htaccess
# =========================================================

RewriteEngine On


# =========================================================
# FORCE HTTPS
# =========================================================

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://concreteartsindia.in%{REQUEST_URI} [R=301,L]


# =========================================================
# FORCE NON-WWW
#
# www.concreteartsindia.in -> concreteartsindia.in
# =========================================================

RewriteCond %{HTTP_HOST} ^www\.concreteartsindia\.in$ [NC]
RewriteRule ^ https://concreteartsindia.in%{REQUEST_URI} [R=301,L]


# =========================================================
# DEFAULT DIRECTORY FILE
# =========================================================

DirectoryIndex index.php


# =========================================================
# REDIRECT DIRECT .PHP REQUESTS TO CLEAN URL
#
# /about.php    -> /about
# /team.php     -> /team
# /products.php -> /products
# /projects.php -> /projects
# /gallery.php  -> /gallery
# /contact.php  -> /contact
# =========================================================

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]


# =========================================================
# DO NOT REWRITE EXISTING FILES / DIRECTORIES
# =========================================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# =========================================================
# CLEAN PHP URLs
#
# /about    -> /about.php
# /team     -> /team.php
# /products -> /products.php
# /projects -> /projects.php
# /gallery  -> /gallery.php
# /contact  -> /contact.php
# =========================================================

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)$ $1.php [L]


# =========================================================
# CUSTOM 404
# =========================================================

ErrorDocument 404 /404.php


# =========================================================
# PREVENT DIRECTORY LISTING
# =========================================================

Options -Indexes


# =========================================================
# PROTECT SENSITIVE FILES
# =========================================================

<FilesMatch "^(db\.php|config\.php|\.env|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>


# =========================================================
# BLOCK BACKUP / SOURCE FILES
# =========================================================

<FilesMatch "\.(bak|backup|old|orig|save|sql|log|ini)$">
    Require all denied
</FilesMatch>