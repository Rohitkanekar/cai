# =========================================================
# CONCRETE ARTS INDIA - ROOT .htaccess
# =========================================================

RewriteEngine On

# =========================================================
# FORCE HTTPS
# =========================================================

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://concreteartsindia.in%{REQUEST_URI} [R=301,L]

# =========================================================
# FORCE NON-WWW
# www.concreteartsindia.in -> concreteartsindia.in
# =========================================================

RewriteCond %{HTTP_HOST} ^www\.concreteartsindia\.in$ [NC]
RewriteRule ^ https://concreteartsindia.in%{REQUEST_URI} [R=301,L]

# =========================================================
# DEFAULT DIRECTORY FILE
# =========================================================

DirectoryIndex index.php

# =========================================================
# CLEAN PRODUCT URL
#
# /product/royal-frp-planter-ry3r55
#
# internally becomes:
#
# /product-details.php?slug=royal-frp-planter-ry3r55
# =========================================================

RewriteRule ^product/([a-zA-Z0-9-]+)/?$ product.php?slug=$1 [END,QSA]

# =========================================================
# DO NOT REWRITE EXISTING FILES / DIRECTORIES
# =========================================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# =========================================================
# CUSTOM 404
# =========================================================

ErrorDocument 404 /404.php

# =========================================================
# PREVENT DIRECTORY LISTING
# =========================================================

Options -Indexes

# =========================================================
# PROTECT SENSITIVE FILES
# =========================================================

<FilesMatch "^(db\.php|config\.php|\.env|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# =========================================================
# BLOCK BACKUP / SOURCE FILES
# =========================================================

<FilesMatch "\.(bak|backup|old|orig|save|sql|log|ini)$">
    Require all denied
</FilesMatch>